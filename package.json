{
  "name": "next-list",
  "version": "2.0.0",
  "description": "artisan route:list for Next.js — inspect App Router pages, route handlers and special files from the terminal.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "bin": {
    "next-list": "bin/next-list.js"
  },
  "files": [
    "bin",
    "lib",
    "action.js",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/next-list.js --dir fixtures/demo-app",
    "test": "node --test test/*.test.js",
    "list": "node bin/next-list.js",
    "list:demo": "node bin/next-list.js --dir fixtures/demo-app --stats",
    "list:md": "node bin/next-list.js --dir fixtures/demo-app --md",
    "screenshots": "bash scripts/capture-screenshots.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablolizardo/next-list.git"
  },
  "keywords": [
    "next.js",
    "next",
    "nextjs",
    "app-router",
    "routes",
    "cli",
    "tool",
    "visualization",
    "debugging",
    "api",
    "github-action",
    "route-list"
  ],
  "author": {
    "name": "Pablo Lizardo",
    "email": "info@pablolizardo.dev",
    "url": "https://www.pablolizardo.dev"
  },
  "license": "MIT",
  "dependencies": {
    "cli-table3": "^0.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/pablolizardo/next-list/issues"
  },
  "homepage": "https://github.com/pablolizardo/next-list#readme"
}
